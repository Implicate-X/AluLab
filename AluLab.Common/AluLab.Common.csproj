<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net10.0-browser;net10.0-android</TargetFrameworks>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <DefineConstants>$(DefineConstants);ALULAB_LOGOVERLAY</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-browser' or '$(TargetFramework)' == 'net10.0-android'">
    <Compile Remove="Relay\SyncHub.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.Debug" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\LED7SegmentsModule.axaml.cs">
      <DependentUpon>LED7SegmentsModule.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\HousingWindow.axaml.cs">
      <DependentUpon>HousingWindow.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\HousingView.axaml.cs">
      <DependentUpon>HousingView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Views\HousingWindow.axaml.cs">
      <DependentUpon>HousingWindow.axaml</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>
