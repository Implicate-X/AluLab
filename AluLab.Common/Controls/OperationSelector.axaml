<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:c="clr-namespace:AluLab.Common.Controls"
			 mc:Ignorable="d" d:DesignWidth="228" d:DesignHeight="120"
			 x:Class="AluLab.Common.Controls.OperationSelector">
	<UserControl.Styles>
		<!-- Tile base -->
		<Style Selector="Border.op-tile">
			<Setter Property="Background" Value="White"/>
			<Setter Property="BorderBrush" Value="#CCCCCC"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="8"/>
			<Setter Property="Padding" Value="6"/>
		</Style>

		<!-- Selected tile -->
		<Style Selector="Border.op-tile.selected">
			<Setter Property="Background" Value="#FFDDEEFF"/>
			<Setter Property="BorderBrush" Value="#FF2B78D6"/>
			<Setter Property="BorderThickness" Value="2"/>
		</Style>

		<!-- Hover feedback -->
		<Style Selector="Border.op-tile:pointerover">
			<Setter Property="Background" Value="#FFF3F3F3"/>
		</Style>
	</UserControl.Styles>

	<Border Background="#F7F7F7"
			BorderBrush="#CCCCCC"
			BorderThickness="1"
			CornerRadius="8"
			Padding="8"
			Width="228"
			Height="120">

		<UniformGrid x:Name="TilesGrid"
					 Width="216"
					 Height="90"
					 Columns="4"
					 Rows="4"
					 Margin="0,2,0,0"
					 HorizontalAlignment="Stretch"
					 VerticalAlignment="Stretch" />
	</Border>
</UserControl>

